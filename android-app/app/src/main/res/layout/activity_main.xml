<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/dateText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:letterSpacing="0.04" android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/greetingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/greeting_text_text" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary"/>
        </LinearLayout>
        <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:background="@drawable/chip_background" android:text="@string/activity_main_item_1_text" android:textSize="18sp" android:textColor="@color/primary" android:contentDescription="@string/activity_main_item_2_content_description"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/nextStepCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/accent_card" android:orientation="vertical">
        <TextView android:id="@+id/journeyPathText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/journey_path_text" android:textColor="@color/primary" android:textSize="12sp" android:letterSpacing="0.03"/>
        <TextView android:id="@+id/nextStepTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_primary" android:textSize="18sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/nextStepBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="3dp"/>
        <Button android:id="@+id/nextStepButton" style="@style/PrimaryButton" android:layout_marginTop="12dp" android:layout_height="48dp" android:textSize="14sp"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginBottom="12dp" android:text="@string/activity_main_item_3_text" android:textColor="@color/text_secondary" android:textSize="13sp"/>
    <FrameLayout android:id="@+id/projectCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/hero_background">
        <com.example.dailyrecord.ui.components.OrbitView android:layout_width="142dp" android:layout_height="142dp" android:layout_gravity="end|top" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
            <TextView android:id="@+id/categoryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E1D9FC" android:textSize="12sp" android:letterSpacing="0.05"/>
            <TextView android:id="@+id/projectName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingEnd="65dp" android:text="@string/project_name_text" android:textColor="#FFFFFF" android:textSize="28sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/stageText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#E1D9FC" android:textSize="13sp"/>
            <ProgressBar android:id="@+id/stageProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="22dp" android:max="100" android:progressTint="#C9B5FF" android:progressBackgroundTint="#554089" android:contentDescription="@string/stage_progress_content_description"/>
            <TextView android:id="@+id/targetText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="#FFFFFF" android:textSize="15sp" android:lineSpacingExtra="3dp"/>
            <TextView android:id="@+id/reasonText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#D5C9EF" android:textSize="12sp"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/statsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/card_background" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/activity_main_item_4_text" android:textColor="@color/text_primary" android:textSize="16sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_main_item_5_text" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/recordCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/record_count_text" android:textSize="28sp" android:textColor="@color/primary" android:fontFamily="sans-serif-medium"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_main_item_6_text" android:textSize="12sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/successRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/success_rate_text" android:textSize="28sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/activity_main_item_7_text" android:textSize="12sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/statsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/activeActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
        <Button android:id="@+id/checkInButton" style="@style/PrimaryButton" android:layout_width="0dp" android:layout_weight="1" android:drawableStart="@drawable/ic_plus" android:drawableTint="#FFFFFF" android:drawablePadding="8dp" android:text="@string/check_in_button_text"/>
        <Space android:layout_width="12dp" android:layout_height="1dp"/>
        <Button android:id="@+id/historyButton" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/history_button_text"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/accent_card" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_item_8_text" android:textColor="@color/primary_dark" android:textSize="17sp" android:fontFamily="sans-serif-medium"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/activity_main_item_9_text" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <Button android:id="@+id/emergencyButton" style="@style/SecondaryButton" android:layout_marginTop="12dp" android:text="@string/emergency_button_text" android:drawableEnd="@drawable/ic_arrow"/>
    </LinearLayout>
    <Button android:id="@+id/createProjectButton" style="@style/SecondaryButton" android:layout_marginTop="14dp" android:text="@string/create_project_button_text"/>
</LinearLayout>
</ScrollView>
</LinearLayout>
